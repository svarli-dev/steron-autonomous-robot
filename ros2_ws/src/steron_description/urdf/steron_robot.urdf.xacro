<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="steron_robot">

  <!--
    Temporary/provisional dimensions.
    These will be replaced with measured physical-robot values later.
  -->
  <xacro:property name="body_length" value="0.30"/>
  <xacro:property name="body_width"  value="0.22"/>
  <xacro:property name="body_height" value="0.08"/>
  <xacro:property name="body_mass"   value="1.5"/>
  <xacro:property name="body_clearance" value="0.06"/>

  <!-- Differential-drive geometry -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.02"/>
  <xacro:property name="wheel_mass"   value="0.10"/>
  <xacro:property name="wheel_track"  value="0.20"/>
  <xacro:property name="wheel_x"      value="-0.05"/>
  <xacro:property name="wheel_z"      value="0.05"/>

  <!-- Caster geometry -->
  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_width" value="0.02"/>
  <xacro:property name="caster_mass" value="0.08"/>
  <xacro:property name="caster_x" value="0.10"/>
  <xacro:property name="caster_y" value="0.0"/>
  <xacro:property name="caster_z" value="0.35"/>

  <xacro:property name="caster_trail" value="0.025"/>
  <xacro:property name="caster_fork_height" value="${body_clearance - caster_radius}"/>

  <!-- Box inertia for a uniform rectangular body -->
  <xacro:property
    name="ixx"
    value="${body_mass / 12.0 * (body_width * body_width + body_height * body_height)}"/>

  <xacro:property
    name="iyy"
    value="${body_mass / 12.0 * (body_length * body_length + body_height * body_height)}"/>

  <xacro:property
    name="izz"
    value="${body_mass / 12.0 * (body_length * body_length + body_width * body_width)}"/>


  <!-- ==================== BASE ==================== -->

  <link name="base_link">

    <inertial>
      <origin
        xyz="0 0 ${body_clearance + body_height / 2.0}"
        rpy="0 0 0"/>

      <mass value="${body_mass}"/>

      <inertia
        ixx="${ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${iyy}"
        iyz="0.0"
        izz="${izz}"/>
    </inertial>

    <visual>
      <origin
        xyz="0 0 ${body_clearance + body_height / 2.0}"
        rpy="0 0 0"/>

      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </visual>

    <collision>
      <origin
        xyz="0 0 ${body_clearance + body_height / 2.0}"
        rpy="0 0 0"/>

      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== LEFT WHEEL ==================== -->

  <link name="left_wheel_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${wheel_mass}"/>

      <inertia
        ixx="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
        iyz="0.0"
        izz="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"/>
    </inertial>

    <visual>
      <origin
        xyz="0 0 0"
        rpy="${pi / 2.0} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </visual>

    <collision>
      <origin
        xyz="0 0 0"
        rpy="${pi / 2.0} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== LEFT WHEEL JOINT ==================== -->

  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin
      xyz="${wheel_x} ${wheel_track / 2.0} ${wheel_z}"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>

<!-- ==================== RIGHT WHEEL ==================== -->

  <link name="right_wheel_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${wheel_mass}"/>

      <inertia
        ixx="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
        iyz="0.0"
        izz="${wheel_mass / 12.0 * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"/>
    </inertial>

    <visual>
      <origin
        xyz="0 0 0"
        rpy="${pi / 2.0} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </visual>

    <collision>
      <origin
        xyz="0 0 0"
        rpy="${pi / 2.0} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </collision>

  </link>


<!-- ==================== RIGHT WHEEL JOINT ==================== -->

  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin
      xyz="${wheel_x} -${wheel_track / 2.0} ${wheel_z}"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ==================== CASTER SWIVEL LINK ==================== -->

  <link name="caster_swivel_link">

    <inertial>
      <origin
        xyz="0 0 -${caster_fork_height / 2.0}"
        rpy="0 0 0"/>

      <mass value="${caster_mass}"/>

      <inertia
        ixx="${caster_mass / 12.0 * (0.02 * 0.02 + 0.05 * 0.05)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${caster_mass / 12.0 * (0.02 * 0.02 + 0.05 * 0.05)}"
        iyz="0.0"
        izz="${caster_mass / 12.0 * (0.02 * 0.02)}"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>

      <geometry>
        <box
          size="0.02 0.02 ${caster_fork_height}"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>

      <geometry>
        <box size="0.02 0.02 0.05"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== CASTER SWIVEL JOINT ==================== -->

  <joint name="caster_swivel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="caster_swivel_link"/>

    <origin
      xyz="${caster_x} ${caster_y} ${body_clearance}"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>

  <!-- ==================== CASTER WHEEL ==================== -->

  <link name="caster_wheel_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${caster_mass}"/>

      <inertia
        ixx="${caster_mass / 12.0 * (3.0 * caster_radius * caster_radius + caster_width * caster_width)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.5 * caster_mass * caster_radius * caster_radius}"
        iyz="0.0"
        izz="${caster_mass / 12.0 * (3.0 * caster_radius * caster_radius + caster_width * caster_width)}"/>
    </inertial>

    <visual>
      <origin
        xyz="0 0 0"
        rpy="${pi / 2.0} 0 0"/>

      <geometry>
        <cylinder
          radius="${caster_radius}"
          length="${caster_width}"/>
      </geometry>
    </visual>

    <collision>
      <origin
        xyz="0 0 0"
        rpy="${pi / 2.0} 0 0"/>

      <geometry>
        <cylinder
          radius="${caster_radius}"
          length="${caster_width}"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== CASTER WHEEL JOINT ==================== -->

  <joint name="caster_wheel_joint" type="continuous">

    <parent link="caster_swivel_link"/>
    <child link="caster_wheel_link"/>

    <origin
      xyz="-${caster_trail} 0 -${caster_fork_height}"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>

</robot>
